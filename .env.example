# Copy this file to .env and replace the placeholders with your PostgreSQL credentials.
DATABASE_URL=postgresql://admin:admin123@localhost:5432/web_du_lich
# Physical directory used to persist uploaded images in production.
UPLOAD_DIR=/var/www/uploads

# Relative public URL served by Nginx (or another reverse proxy).
UPLOAD_PUBLIC_BASE_URL=/uploads

# Maximum allowed size for each image.
MAX_UPLOAD_IMAGE_MB=8
