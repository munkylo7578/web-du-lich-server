# Copy this file to .env and replace the placeholders with your PostgreSQL credentials.
DATABASE_URL=postgresql://admin:admin123@localhost:5432/web_du_lich
# NestJS API. Generate each key with at least 32 random bytes and comma-separate keys during rotation.
API_KEYS=replace-with-a-long-random-server-only-key
API_PORT=3001
API_MAX_PAGE_SIZE=100
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_LIMIT=120
# Comma-separated origins. Leave empty when only server-to-server calls are allowed.
API_CORS_ORIGINS=
# Set to 1 only when the API is behind exactly one trusted reverse proxy (for example Nginx).
API_TRUST_PROXY=0
# Comma-separated setting keys that are explicitly safe to expose through the public content API.
API_PUBLIC_SETTING_KEYS=site_name,site_description,logo,contact_phone,contact_email
# Disable Swagger in production unless access is restricted at the reverse proxy.
API_DOCS_ENABLED=true
# Physical directory used to persist uploaded images in production.
UPLOAD_DIR=/var/www/uploads

# Relative public URL served by Nginx (or another reverse proxy).
UPLOAD_PUBLIC_BASE_URL=/uploads

# Maximum allowed size for each image.
MAX_UPLOAD_IMAGE_MB=8
